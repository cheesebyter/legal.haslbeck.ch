{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal.haslbeck.ch/schemas/terms-modules.schema.json",
  "type": "object",
  "minProperties": 1,
  "propertyNames": {
    "pattern": "^[a-z][a-z0-9-]*$"
  },
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["title", "required", "required_fields"],
    "properties": {
      "title": { "type": "string", "minLength": 1 },
      "required": { "type": "boolean" },
      "required_fields": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    }
  }
}
