{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal.haslbeck.ch/schemas/changelog.schema.json",
  "type": "object",
  "additionalProperties": {
    "type": "array",
    "items": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "date", "status", "documents", "summaries"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-draft)?$"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "enum": ["draft", "published"]
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["imprint", "privacy", "terms"]
          }
        },
        "summaries": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "de": { "type": "string", "minLength": 1 },
            "fr": { "type": "string", "minLength": 1 },
            "it": { "type": "string", "minLength": 1 },
            "es": { "type": "string", "minLength": 1 },
            "en": { "type": "string", "minLength": 1 }
          },
          "required": ["de"]
        }
      }
    }
  }
}
