---
pagination:
  data: projects
  size: 1
  alias: project
permalink: "/{{ project.project_id }}/impressum/index.html"
layout: base.njk
lang: de
eleventyComputed:
  title: "Impressum {{ project.name }}"
  description: "Deutsche Standardfassung des Impressums für {{ project.name }}"
  canonical_url: "{{ site.base_url }}/de/{{ project.project_id }}/impressum"
---
<article>
  <p class="eyebrow">{{ project.name }} · {{ project.domain }}</p>
  <h1>Impressum</h1>
  {% renderLegalMarkdown "content/imprint/de.md", project, operator %}
  <p><a href="/de/{{ project.project_id }}/impressum">Dauerhafte URL der deutschen Fassung</a></p>
</article>

